   "source": [
    "def gcd(a,b):\n",
    "    assert a>=0 and b>=0 and int (a)==a and int (b)==b,\"for positive number\"\n",
    "    if a == 0 and b>0:\n",
    "        return b;\n",
    "\n",
    "    elif b==0 and a>0 :\n",
    "        return a\n",
    "    else:    \n",
    "        return gcd(b,a%b)\n",
    "gcd(48, 18)    "
   ]
