   "source": [
    "def sumOfDigits(n):\n",
    "    assert n>0 and int (n) == n, \"Positive Integer\"\n",
    "    if n == 0: \n",
    "        return 0\n",
    "    else:    \n",
    "        return int(n%10) + sumOfDigits(n/10)\n",
    "\n",
    "sumOfDigits(4)"
   ]
  },
