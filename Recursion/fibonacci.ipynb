   "source": [
    "def fib(n): \n",
    "    assert n>=0 and int (n) = n,\"Fibonacci is only for \"\n",
    "    if n in [0,1]: \n",
    "        return n\n",
    "    else: \n",
    "        return fib(n-1)+fib(n-2)\n",
    "\n",
    "fib(5)"
   ]
